<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.schoolbus.transport.infrastructure.persistence.seat.TripSeatQueryMapper">

    <select
            id="selectSeatStatusesByTripId"
            resultType="com.schoolbus.transport.infrastructure.persistence.seat.TripSeatStatusDataObject">
        SELECT
            seat_number AS seatNumber,
            status
        FROM transport_trip_seat
        WHERE trip_id = #{tripId}
        ORDER BY seat_number ASC
    </select>

</mapper>

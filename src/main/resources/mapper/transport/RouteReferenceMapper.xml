<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.schoolbus.transport.infrastructure.persistence.route.RouteReferenceMapper">

    <select
            id="selectByRouteNo"
            resultType="com.schoolbus.transport.infrastructure.persistence.route.RouteReferenceDataObject">
        SELECT
            id,
            route_no AS routeNo,
            status
        FROM transport_route
        WHERE route_no = #{routeNo}
        LIMIT 1
    </select>

    <select
            id="selectById"
            resultType="com.schoolbus.transport.infrastructure.persistence.route.RouteReferenceDataObject">
        SELECT
            id,
            route_no AS routeNo,
            status
        FROM transport_route
        WHERE id = #{id}
        LIMIT 1
    </select>

</mapper>

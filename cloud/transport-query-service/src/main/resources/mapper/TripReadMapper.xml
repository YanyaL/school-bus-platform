<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.schoolbus.transportquery.infrastructure.persistence.TripReadMapper">

    <resultMap
            id="TripReadResultMap"
            type="com.schoolbus.transportquery.infrastructure.persistence.TripReadDataObject">
        <id property="id" column="id"/>
        <result property="tripNumber" column="trip_no"/>
        <result property="vehicleId" column="vehicle_id"/>
        <result property="routeId" column="route_id"/>
        <result property="departureTime" column="departure_time"/>
        <result property="bookingDeadline" column="booking_deadline"/>
        <result property="price" column="price"/>
    </resultMap>

    <select id="selectBookableTrips" resultMap="TripReadResultMap">
        SELECT
            id,
            trip_no,
            vehicle_id,
            route_id,
            departure_time,
            booking_deadline,
            price
        FROM transport_trip
        WHERE status = 'OPEN_FOR_BOOKING'
          AND booking_deadline &gt; #{now}
          AND departure_time &gt; #{now}
        ORDER BY departure_time ASC, id ASC
        LIMIT #{limit}
    </select>

    <select id="selectByTripNumber" resultMap="TripReadResultMap">
        SELECT
            id,
            trip_no,
            vehicle_id,
            route_id,
            departure_time,
            booking_deadline,
            price
        FROM transport_trip
        WHERE trip_no = #{tripNumber}
        LIMIT 1
    </select>

</mapper>
